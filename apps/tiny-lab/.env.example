# tiny-lab — copie para .env e preencha. O .env NUNCA é versionado.

# Credenciais da aplicação OAuth cadastrada no painel do Tiny.
TINY_CLIENT_ID=
TINY_CLIENT_SECRET=

# Precisa estar cadastrado como redirect URI válido na aplicação do Tiny.
TINY_REDIRECT_URI=http://localhost:8080/oauth/tiny/callback

# Só "sandbox" habilita escrita. É o primeiro dos dois portões.
TINY_ENV=sandbox

# Segundo portão, e o único que protege de verdade: a API v3 tem host único
# (api.tiny.com.br), então não existe ambiente de teste separado — a fronteira
# é a CONTA. Só se escreve em conta cujo cpfCnpj (GET /info) esteja aqui.
# Rode `tiny-lab auth status` que ele imprime o CNPJ da conta autorizada.
TINY_ALLOWED_CNPJ=

# Porta da ponte de webhooks.
TINY_HOOKS_PORT=8787

# Envie code_challenge S256 no login (false se o Keycloak recusar).
TINY_PKCE=true
