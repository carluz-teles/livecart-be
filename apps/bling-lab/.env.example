# Credenciais do APLICATIVO cadastrado em developer.bling.com.br
# (são do aplicativo, não da conta do lojista)
BLING_CLIENT_ID=
BLING_CLIENT_SECRET=

# O redirect que está CADASTRADO no aplicativo.
#
# ⚠ O Bling IGNORA o redirect_uri enviado na requisição e usa sempre o do
# cadastro. Divergir aqui não dá erro na hora — dá um callback que nunca chega.
#
# Se o Bling aceitar localhost, esta é a opção mais simples e não precisa de túnel:
BLING_REDIRECT_URI=http://localhost:8790/callback
#
# Se NÃO aceitar, cadastre a URL do túnel e ponha-a aqui. A porta local onde o
# servidor de callback escuta continua sendo a BLING_CALLBACK_PORT:
# BLING_REDIRECT_URI=https://SEU-TUNEL.trycloudflare.com/callback
BLING_CALLBACK_PORT=8790

# Porta local da ponte de webhooks. É para ela que o túnel aponta, e a URL
# pública do túnel é o que se cadastra na aba Webhooks do aplicativo.
BLING_HOOKS_PORT=8791

# Freio local, em requisições por segundo.
#
# O teto do Bling é 3/s POR CONTA, somando TODOS os apps do lojista — se ele tem
# e-commerce ou marketplace plugado no mesmo Bling, eles comem da mesma cota e
# são invisíveis para nós. Não há header de cota para reconciliar (medido).
# Por isso o padrão é 2, não 3.
BLING_RATE_LIMIT_RPS=2

# ─── ESCRITA ───────────────────────────────────────────────────────────────
# O Bling NÃO TEM SANDBOX. Tudo roda contra a conta real de um lojista.
# Escrita exige as DUAS chaves abaixo, e o id da conta é conferido contra
# GET /empresas/me/dados-basicos antes de qualquer verbo de escrita sair.
# Deixe como está até haver autorização explícita do dono da conta.
BLING_ALLOW_WRITE=false
BLING_ALLOWED_COMPANY_ID=

# ─── endpoints (só mexer para apontar ao fake-bling) ────────────────────────
# BLING_AUTH_URL=https://bling.com.br/Api/v3/oauth/authorize
# BLING_TOKEN_URL=https://bling.com.br/Api/v3/oauth/token
# BLING_REVOKE_URL=https://bling.com.br/Api/v3/oauth/revoke
# BLING_API_BASE=https://api.bling.com.br/Api/v3
